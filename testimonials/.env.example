# Basic auth for the PLATFORM admin at /admin (your operator view of all
# users/walls) — REQUIRED. Returns 503 until both are set. Customers never
# see this; they log into /dashboard with their own accounts.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Google sign-in (optional but recommended) ---
# 1. console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID (Web application)
# 3. Authorized redirect URI: {APP_URL}/api/auth/google/callback
# The Google button appears on /login and /signup automatically once set.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Stripe (optional until you want to charge) ---
# 1. dashboard.stripe.com → create a recurring Price for Pro (e.g. $19/mo),
#    copy its price_... id
# 2. Developers → API keys → secret key
# 3. Developers → Webhooks → add endpoint {APP_URL}/api/billing/webhook with
#    events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted → copy the signing secret
# Upgrade buttons appear and work automatically once all three are set.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where SQLite + uploaded avatars live. Mount a volume here in production.
# Defaults to ./data relative to the working directory.
# DATA_DIR=/data

# Public origin of this deployment (used for OG tags and share links).
# APP_URL=https://testimonials.example.com

# Branding of the "Powered by" badge shown on free-tier walls.
# PRODUCT_NAME=Lovewall
# PRODUCT_URL=https://github.com/GitLiamNow/testimonials

# --- Vercel (serverless) deployment only ---
# Vercel's filesystem is ephemeral, so point the database at Turso (hosted
# SQLite) and avatars at Vercel Blob. Locally / on a VPS, leave all three
# unset and everything lives in DATA_DIR.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...   (auto-set when you add a Blob store on Vercel)
