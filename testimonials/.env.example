# Basic auth for /admin — REQUIRED. The admin panel returns 503 until both are set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where SQLite + uploaded avatars live. Mount a volume here in production.
# Defaults to ./data relative to the working directory.
# DATA_DIR=/data

# Public origin of this deployment (used for OG tags and share links).
# APP_URL=https://testimonials.example.com

# Branding of the "Powered by" badge shown on free-tier walls.
# PRODUCT_NAME=Lovewall
# PRODUCT_URL=https://github.com/GitLiamNow/testimonials

# --- Vercel (serverless) deployment only ---
# Vercel's filesystem is ephemeral, so point the database at Turso (hosted
# SQLite) and avatars at Vercel Blob. Locally / on a VPS, leave all three
# unset and everything lives in DATA_DIR.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...   (auto-set when you add a Blob store on Vercel)
